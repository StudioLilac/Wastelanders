<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Tooltip.uss?fileID=7433441132597879392&amp;guid=9d5d30a81995149389b2c019af547af1&amp;type=3#Tooltip" />
    <ui:VisualElement name="tooltip-box" class="tooltip" style="position: absolute;">
        <ui:VisualElement name="tooltip-bg" class="background" style="width: 354px; margin-top: 16px; padding-top: 19px; padding-left: 20px; padding-right: 22px; padding-bottom: 30px; -unity-font-definition: initial; -unity-font: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/VT323-Regular.ttf?fileID=12800000&amp;guid=46b9139fed5cc6a42a6a5d42b82c3c7e&amp;type=3#VT323-Regular&quot;); font-size: 28px; color: rgb(0, 0, 0); min-height: 158px; -unity-slice-left: 22; -unity-slice-top: 22; -unity-slice-right: 22; -unity-slice-bottom: 22; -unity-slice-scale: 3.590909px; height: auto; flex-direction: column; flex-grow: 0; flex-wrap: nowrap;">
            <ui:VisualElement name="header-row" style="flex-grow: 0; flex-direction: row; justify-content: space-between; flex-shrink: 0;">
                <ui:VisualElement name="title-col" style="flex-grow: 1;">
                    <ui:Label name="buff-name" text="ACCURACY" style="white-space: normal; font-size: 36px; margin-top: 0; padding-top: 0; padding-bottom: 0; margin-bottom: 0;" />
                    <ui:Label name="buff-stacks" text="3 Stacks" style="white-space: normal; color: rgb(0, 108, 161); margin-top: 0; padding-top: 0; padding-bottom: 0; margin-bottom: 0;" />
                </ui:VisualElement>
                <ui:VisualElement name="buff-icon" class="icon" style="flex-grow: 1; width: auto; height: auto; -unity-text-align: upper-left; -unity-background-scale-mode: scale-to-fit; background-position-y: top 0; background-position-x: right 0;" />
            </ui:VisualElement>
            <ui:Label text="This is the description of the buff being displayed on the tooltip." name="buff-description" style="white-space: normal; flex-grow: 0;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
