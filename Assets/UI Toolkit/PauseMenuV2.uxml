<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/PauseMenuV2.uss?fileID=7433441132597879392&amp;guid=915e709ecdac2473ba299c17517b10e4&amp;type=3#PauseMenuV2" />
    <ui:Button name="pause-icon-button" class="button" style="background-image: url(&quot;project://database/Assets/Sprites/pause-menu-v2/PauseIcon2.png?fileID=21300000&amp;guid=9b852aa43b8b5cc4f80437a46b006415&amp;type=3#PauseIcon2&quot;); height: 64px; width: 64px; position: absolute; right: 32px; top: 32px; display: flex;" />
    <ui:VisualElement name="pause-menu-root" enabled="true" style="background-color: rgba(0, 0, 0, 0.8); position: absolute; left: 0; top: 0; right: 0; bottom: 0;">
        <ui:VisualElement name="pause-menu-panel" style="align-items: center; position: absolute; left: 0; top: 0; right: 0; bottom: 0; justify-content: center; flex-direction: row; display: flex;">
            <ui:VisualElement style="background-image: url(&quot;project://database/Assets/Sprites/pause-menu-v2/bg-pause-menu.png?fileID=2800000&amp;guid=4945b1b75b61d462483e9484d7b5273e&amp;type=3#bg-pause-menu&quot;); -unity-slice-left: 32; -unity-slice-top: 32; -unity-slice-right: 32; -unity-slice-bottom: 32; padding-right: 240px; padding-left: 240px; -unity-slice-scale: 12px; align-self: stretch; justify-content: center; align-items: center; margin-top: 64px; margin-bottom: 64px;">
                <ui:Button text="RESUME" name="button-rsm" class="button-bg" style="-unity-font: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/VT323-Regular.ttf?fileID=12800000&amp;guid=46b9139fed5cc6a42a6a5d42b82c3c7e&amp;type=3#VT323-Regular&quot;); -unity-font-definition: initial; color: rgb(203, 108, 230); font-size: 72px; height: 120px; width: 360px;" />
                <ui:Button text="RESTART" name="button-rst" class="button-bg" style="margin-top: 64px; -unity-font: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/VT323-Regular.ttf?fileID=12800000&amp;guid=46b9139fed5cc6a42a6a5d42b82c3c7e&amp;type=3#VT323-Regular&quot;); -unity-font-definition: initial; color: rgb(203, 108, 230); font-size: 72px; height: 120px; width: 360px;" />
                <ui:Button text="deck select" name="button-dck" class="button" style="-unity-font: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/VT323-Regular.ttf?fileID=12800000&amp;guid=46b9139fed5cc6a42a6a5d42b82c3c7e&amp;type=3#VT323-Regular&quot;); -unity-font-definition: initial; color: rgb(203, 108, 230); font-size: 72px; margin-top: 64px;" />
                <ui:Button text="level select" name="button-lvl" class="button" style="-unity-font: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/VT323-Regular.ttf?fileID=12800000&amp;guid=46b9139fed5cc6a42a6a5d42b82c3c7e&amp;type=3#VT323-Regular&quot;); -unity-font-definition: initial; color: rgb(203, 108, 230); font-size: 72px; margin-top: 32px;" />
                <ui:Button text="main menu" name="button-mnu" class="button" style="-unity-font: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/VT323-Regular.ttf?fileID=12800000&amp;guid=46b9139fed5cc6a42a6a5d42b82c3c7e&amp;type=3#VT323-Regular&quot;); -unity-font-definition: initial; color: rgb(203, 108, 230); font-size: 72px; margin-top: 32px;" />
            </ui:VisualElement>
            <ui:VisualElement style="margin-left: 64px; align-items: flex-start;">
                <ui:VisualElement style="flex-direction: row; align-items: center;">
                    <ui:Toggle name="toggle-mus" class="button toggle" style="height: 120px; width: 120px;" />
                    <ui:Slider high-value="1" name="slider-mus" class="slider" style="height: 55px; width: 345px; margin-left: 32px;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-top: 64px;">
                    <ui:Toggle name="toggle-sfx" class="button toggle" style="height: 120px; width: 120px;" />
                    <ui:Slider high-value="1" name="slider-sfx" class="slider" style="height: 55px; width: 345px; margin-left: 32px;" />
                </ui:VisualElement>
                <ui:Toggle name="toggle-vfx" class="button toggle" style="align-items: center; margin-top: 64px;">
                    <ui:Label text="Screen Shake" style="-unity-font: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/VT323-Regular.ttf?fileID=12800000&amp;guid=46b9139fed5cc6a42a6a5d42b82c3c7e&amp;type=3#VT323-Regular&quot;); -unity-font-definition: initial; color: rgb(203, 108, 230); font-size: 72px; margin-left: 32px;" />
                </ui:Toggle>
                <ui:Button name="button-gls" class="button" style="flex-direction: row; align-items: center; margin-top: 64px; background-color: transparent; border-width: 0; margin-left: 0; padding: 0;">
                    <ui:VisualElement style="height: 120px; width: 120px; background-image: url(&quot;project://database/Assets/Sprites/pause-menu-v2/ic-glossary.png?fileID=2800000&amp;guid=ce77eb358f2d54544adbd71c03209471&amp;type=3#ic-glossary&quot;);" />
                    <ui:Label text="Glossary" style="-unity-font: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/VT323-Regular.ttf?fileID=12800000&amp;guid=46b9139fed5cc6a42a6a5d42b82c3c7e&amp;type=3#VT323-Regular&quot;); -unity-font-definition: initial; color: rgb(203, 108, 230); font-size: 72px; margin-left: 32px; padding: 0;" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="glossary" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; display: flex;">
            <ui:Button name="button-cls" class="button" style="background-image: url(&quot;project://database/Assets/Sprites/pause-menu-v2/ic-close.png?fileID=21300000&amp;guid=85c43d65ec01844e7a2589a76e7c82b5&amp;type=3#ic-close&quot;); height: 120px; position: absolute; right: 32px; top: 32px; width: 120px;" />
            <ui:Label text="Glossary" style="-unity-font: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/VT323-Regular.ttf?fileID=12800000&amp;guid=46b9139fed5cc6a42a6a5d42b82c3c7e&amp;type=3#VT323-Regular&quot;); -unity-font-definition: initial; font-size: 72px; color: rgb(255, 255, 255); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
            <ui:VisualElement style="background-image: url(&quot;project://database/Assets/Sprites/pause-menu-v2/bg-pause-menu.png?fileID=2800000&amp;guid=4945b1b75b61d462483e9484d7b5273e&amp;type=3#bg-pause-menu&quot;); -unity-slice-left: 32; -unity-slice-top: 32; -unity-slice-right: 32; -unity-slice-bottom: 32; -unity-slice-scale: 12px; flex-direction: row; width: 1700px; height: 900px; padding-top: 120px; padding-right: 120px; padding-bottom: 120px; padding-left: 120px; justify-content: space-between;">
                <ui:VisualElement style="align-items: flex-start; justify-content: flex-start; width: 768px;">
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:VisualElement style="width: 157px; height: 400px; background-image: url(&quot;project://database/Assets/Sprites/UISprites/clashIcons/ClashIcons%201.PNG?fileID=2800000&amp;guid=1f4c096669ed14046aab90b76fc47759&amp;type=3#ClashIcons 1&quot;); -unity-background-scale-mode: scale-to-fit; justify-content: space-around; align-items: stretch;" />
                        <ui:Label text="&lt;b&gt;Clashes&lt;/b&gt;&#10;Forms when two entities mutually target each other with an Action. &#10;The Action that rolls a higher power staggers the loser. Negating damage, &quot;On Hit&quot;, and &quot;Not Staggered&quot; effects.&#10;Battle-queue clash icons illustrate your chances of winning/tying a clash.&#10;The Clash has the same speed as the fastest speed between the two Actions." style="-unity-font: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/VT323-Regular.ttf?fileID=12800000&amp;guid=46b9139fed5cc6a42a6a5d42b82c3c7e&amp;type=3#VT323-Regular&quot;); -unity-font-definition: initial; font-size: 38px; color: rgb(255, 255, 255); margin-left: 32px; white-space: normal; height: 371px; width: 596px;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; align-items: center; margin-top: 64px; justify-content: flex-start;">
                        <ui:VisualElement style="width: 159px; height: 197px; background-image: url(&quot;project://database/Assets/Sprites/SceneProps/Frog_Charge_Up_Icon%201.png?fileID=2800000&amp;guid=78ba18018c7a46446b97ffd2d9388f16&amp;type=3#Frog_Charge_Up_Icon 1&quot;); -unity-background-scale-mode: scale-to-fit; justify-content: center; align-items: center;">
                            <ui:VisualElement style="width: 122px; height: 124px; background-image: url(&quot;project://database/Assets/Sprites/UISprites/ArrowIndicator.png?fileID=2800000&amp;guid=03c4a4998b9291e4a8372a967201ac92&amp;type=3#ArrowIndicator&quot;); -unity-background-scale-mode: scale-to-fit;" />
                        </ui:VisualElement>
                        <ui:Label text="&lt;b&gt;Redirecting&lt;/b&gt;&#10;Redirect a slower enemy&apos;s Action from its original target by playing a faster Action on their Action&apos;s on-field or queue icons. Forming a clash. " style="-unity-font: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/VT323-Regular.ttf?fileID=12800000&amp;guid=46b9139fed5cc6a42a6a5d42b82c3c7e&amp;type=3#VT323-Regular&quot;); -unity-font-definition: initial; font-size: 38px; color: rgb(255, 255, 255); margin-left: 32px; white-space: normal; width: 600px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="align-items: flex-start; justify-content: flex-start; width: 45%;">
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:VisualElement style="width: 120px; height: 120px; background-image: url(&quot;project://database/Assets/Sprites/UISprites/BattleBeginButton/Down%20-%20Gold%20Outline%20-%20Text.png?fileID=2800000&amp;guid=0f4d2dbb05e84cf40a18ccc1176dd383&amp;type=3#Down - Gold Outline - Text&quot;); -unity-background-scale-mode: scale-to-fit;" />
                        <ui:Label text="&lt;b&gt;Battle Queue&lt;/b&gt;&#10;Illustrates the order of actions during combat. Sorted by decending speed. Tap to retrieve Actions. Drag Actions from your hand to the Queue Icons to form clashes. Scrollable.&#10;" style="-unity-font: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/VT323-Regular.ttf?fileID=12800000&amp;guid=46b9139fed5cc6a42a6a5d42b82c3c7e&amp;type=3#VT323-Regular&quot;); -unity-font-definition: initial; font-size: 38px; color: rgb(255, 255, 255); margin-left: 32px; white-space: normal; width: 556px;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; align-items: center; margin-top: 64px;">
                        <ui:VisualElement style="width: 120px; height: 120px; background-image: url(&quot;project://database/Assets/Sprites/UISprites/Thicker_Crosshairs.png?fileID=2800000&amp;guid=6f8ab552348e73941b245fe9ca454974&amp;type=3#Thicker_Crosshairs&quot;); -unity-background-scale-mode: scale-to-fit;" />
                        <ui:Label text="&lt;b&gt;One Sided Attacks&lt;/b&gt;&#10;Forms when an Action is played directly on an enemy with no Actions that target you back. Useful to guarantee damage or an ability. " style="-unity-font: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/VT323-Regular.ttf?fileID=12800000&amp;guid=46b9139fed5cc6a42a6a5d42b82c3c7e&amp;type=3#VT323-Regular&quot;); -unity-font-definition: initial; font-size: 38px; color: rgb(255, 255, 255); margin-left: 32px; white-space: normal; width: 556px;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; align-items: flex-start; margin-top: 64px;">
                        <ui:VisualElement style="width: 120px; height: 120px; background-image: url(&quot;project://database/Assets/Sprites/StatusIcon/resonance.png?fileID=2800000&amp;guid=7af708b3e1c4e4b0497edc422888df7c&amp;type=3#resonance&quot;); -unity-background-scale-mode: scale-to-fit;" />
                        <ui:Label text="&lt;b&gt;Status Effects&lt;/b&gt;&#10;Hover over their in game icons to learn more about them!" style="-unity-font: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/VT323-Regular.ttf?fileID=12800000&amp;guid=46b9139fed5cc6a42a6a5d42b82c3c7e&amp;type=3#VT323-Regular&quot;); -unity-font-definition: initial; font-size: 38px; color: rgb(255, 255, 255); margin-left: 32px; white-space: normal; width: 556px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="dialogue" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; display: none;">
            <ui:Button name="button-cls" class="button" style="background-image: url(&quot;project://database/Assets/Sprites/pause-menu-v2/ic-close.png?fileID=21300000&amp;guid=85c43d65ec01844e7a2589a76e7c82b5&amp;type=3#ic-close&quot;); height: 120px; position: absolute; right: 32px; top: 32px; width: 120px;" />
            <ui:Label text="Dialogue History" style="-unity-font: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/VT323-Regular.ttf?fileID=12800000&amp;guid=46b9139fed5cc6a42a6a5d42b82c3c7e&amp;type=3#VT323-Regular&quot;); -unity-font-definition: initial; font-size: 72px; color: rgb(255, 255, 255); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
            <ui:ScrollView name="scroll-dlg" vertical-scroller-visibility="AlwaysVisible" horizontal-scroller-visibility="Hidden" mouse-wheel-scroll-size="48" style="background-image: url(&quot;project://database/Assets/Sprites/pause-menu-v2/bg-pause-menu.png?fileID=2800000&amp;guid=4945b1b75b61d462483e9484d7b5273e&amp;type=3#bg-pause-menu&quot;); -unity-slice-left: 32; -unity-slice-top: 32; -unity-slice-right: 32; -unity-slice-bottom: 32; -unity-slice-scale: 12px; width: 1700px; height: 900px; padding-top: 120px; padding-right: 120px; padding-bottom: 120px; padding-left: 120px;" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="top-left-icons" style="flex-grow: 1; flex-direction: row; position: absolute; left: 24px; top: 24px;">
        <ui:Button name="log-button" style="width: 64px; height: 64px;" />
        <ui:Button name="skip-dialogue-button" style="width: 64px; height: 64px;" />
        <ui:Toggle name="2x-speed-toggle" value="false" style="width: 64px; height: 64px; background-image: url(&quot;project://database/Assets/Sprites/UISprites/HUD/2x%20Spd.png?fileID=2800000&amp;guid=1f8727a4e46b7cc4280962d242fd10ec&amp;type=3#2x Spd&quot;);" />
        <ui:Toggle name="auto-roll-toggle" value="false" style="width: 64px; height: 64px; background-image: url(&quot;project://database/Assets/Sprites/UISprites/HUD/Autoroll.png?fileID=2800000&amp;guid=5a69238af6b2c5d479285c11ea6cbc42&amp;type=3#Autoroll&quot;);" />
    </ui:VisualElement>
</ui:UXML>
