* {
    background-color: transparent;
    border-width: 0;
    margin: 0;
    padding: 0;
}

.button:hover {
    opacity: 0.7;
}

.button:active {
    opacity: 0.4;
}

.button-bg {
    background-image: url("project://database/Assets/Sprites/pause-menu-v2/bg-btn.png?fileID=21300000&guid=a6a4ac5bdd4ea48268cc817b36fc9ff7&type=3#bg-btn");
}

.button-bg:hover {
    background-image: url("project://database/Assets/Sprites/pause-menu-v2/bg-btn-hover.png?fileID=21300000&guid=cad42784cc533405abfbdbb75f5fba4e&type=3#bg-btn-hover");
}

.button-bg:active {
    background-image: url("project://database/Assets/Sprites/pause-menu-v2/bg-btn-click.png?fileID=2800000&guid=c23f722fed69175468210e320637ded4&type=3#bg-btn-click");
}

.slider .unity-base-slider__dragger {
    background-image: url("project://database/Assets/Sprites/UISprites/Volume%20Slider%20Knob.png?fileID=21300000&guid=d6adfb3a59ecf1a4b99e68446ca31bf9&type=3#Volume Slider Knob");
    height: 40px;
    margin-top: -20px;
    scale: 2;
    width: 40px;
}

.slider .unity-base-slider__dragger-border {
    display: none;
}

.slider .unity-base-slider__tracker {
    background-color: rgb(214, 214, 214);
    border-radius: 8px;
    height: 16px;
    margin-top: -8px;
}

.toggle .unity-toggle__input {
    height: 120px;
    width: 120px;
}

.toggle .unity-toggle__checkmark {
    display: none;
}

#toggle-mus .unity-toggle__input {
    background-image: url("project://database/Assets/Sprites/pause-menu-v2/ic-music.png?fileID=2800000&guid=42d6d39ef6dd248f39f0dfa74201cc7d&type=3#ic-music");
}

#toggle-mus:checked .unity-toggle__input {
    background-image: url("project://database/Assets/Sprites/pause-menu-v2/ic-music-muted.png?fileID=2800000&guid=623eac09825ec41e0ac84e378893960d&type=3#ic-music-muted");
}

#toggle-sfx .unity-toggle__input {
    background-image: url("project://database/Assets/Sprites/pause-menu-v2/ic-sound.png?fileID=2800000&guid=b5e9ca402cf7e4068ac074b454961269&type=3#ic-sound");
}

#toggle-sfx:checked .unity-toggle__input {
    background-image: url("project://database/Assets/Sprites/pause-menu-v2/ic-sound-muted.png?fileID=2800000&guid=38ab01e6e119f4546ba11efd83d2141a&type=3#ic-sound-muted");
}

#toggle-vfx .unity-toggle__input {
    background-image: url("project://database/Assets/Sprites/pause-menu-v2/ic-checkbox.png?fileID=2800000&guid=f525fbb470c1744a9aee03f8d8b2ed42&type=3#ic-checkbox");
}

#toggle-vfx:checked .unity-toggle__input {
    background-image: url("project://database/Assets/Sprites/pause-menu-v2/ic-checkbox-checked.png?fileID=2800000&guid=adcf4d5c4eb2d4002be83eed340e12ce&type=3#ic-checkbox-checked");
}

.dynamic-dialogue-name {
    -unity-font: url("project://database/Assets/TextMesh%20Pro/Fonts/VT323-Regular.ttf?fileID=12800000&guid=46b9139fed5cc6a42a6a5d42b82c3c7e&type=3#VT323-Regular");
    -unity-font-definition: initial;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    font-size: 48px;
}

.dynamic-dialogue-text {
    -unity-font: url("project://database/Assets/TextMesh%20Pro/Fonts/VT323-Regular.ttf?fileID=12800000&guid=46b9139fed5cc6a42a6a5d42b82c3c7e&type=3#VT323-Regular");
    -unity-font-definition: initial;
    background-color: rgba(126, 66, 156, 0.2);
    color: rgb(203, 108, 230);
    font-size: 48px;
    white-space: normal;
}

#auto-roll-toggle .unity-toggle__checkmark {
    display: none;
}

#auto-roll-toggle .unity-toggle__input {
    background-image: url("project://database/Assets/Sprites/UISprites/HUD/Autoroll.png?fileID=2800000&guid=5a69238af6b2c5d479285c11ea6cbc42&type=3#Autoroll");
}

#auto-roll-toggle:hover .unity-toggle__input {
    background-image: url("project://database/Assets/Sprites/UISprites/HUD/Autoroll%20-%20Hover%20Down.png?fileID=2800000&guid=02d322928fc942945ac6e6d54adb7f33&type=3#Autoroll - Hover Down");
}

#auto-roll-toggle:checked .unity-toggle__input {
    background-image: url("project://database/Assets/Sprites/UISprites/HUD/Autoroll%20-%20Selected.png?fileID=2800000&guid=18b1a900f6b59d44ba79b35bba02216c&type=3#Autoroll - Selected");
}

#2x-speed-toggle .unity-toggle__checkmark {
    display: none;
}

#2x-speed-toggle .unity-toggle__input {
    background-image: url("project://database/Assets/Sprites/UISprites/HUD/2x%20Spd.png?fileID=2800000&guid=1f8727a4e46b7cc4280962d242fd10ec&type=3#2x Spd");
}

#2x-speed-toggle:hover .unity-toggle__input {
    background-image: url("project://database/Assets/Sprites/UISprites/HUD/2x%20Spd%20-%20Hover%20Down.png?fileID=2800000&guid=735857579b6a81842bf10c677f4e0e27&type=3#2x Spd - Hover Down");
}

#2x-speed-toggle:checked .unity-toggle__input {
    background-image: url("project://database/Assets/Sprites/UISprites/HUD/2x%20Spd%20-%20Selected.png?fileID=2800000&guid=b91ec6a851a5df24ba739e8288304a7a&type=3#2x Spd - Selected");
}

#skip-dialogue-button {
    background-image: url("project://database/Assets/Sprites/UISprites/HUD/Skip.png?fileID=2800000&guid=4a3e2957d797619439c6576f91bf1445&type=3#Skip");
}

#skip-dialogue-button:hover {
    background-image: url("project://database/Assets/Sprites/UISprites/HUD/Skip%20-%20Hover%20Down.png?fileID=2800000&guid=5b2b205e4c7a3c54f857f550a8d57c1b&type=3#Skip - Hover Down");
}

#skip-dialogue-button:active {
    background-image: url("project://database/Assets/Sprites/UISprites/HUD/Skip%20-%20Selected.png?fileID=2800000&guid=19d177e73271751428db2afe7428aee2&type=3#Skip - Selected");
}

#log-button {
    background-image: url("project://database/Assets/Sprites/UISprites/HUD/Log.png?fileID=2800000&guid=c0878658c7e61224982c993218663a22&type=3#Log");
}

#log-button:hover {
    background-image: url("project://database/Assets/Sprites/UISprites/HUD/Log%20-%20Hover%20Down.png?fileID=2800000&guid=a5c0f45a9d27cdd46bfb11d5a26dade8&type=3#Log - Hover Down");
}

#log-button:active {
    background-image: url("project://database/Assets/Sprites/UISprites/HUD/Log%20-%20Selected.png?fileID=2800000&guid=10707dc8cbfae9049a02336094e6d5a1&type=3#Log - Selected");
}
