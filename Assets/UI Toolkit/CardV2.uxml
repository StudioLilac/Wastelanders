    <UI_Toolkit.UI_Elements.CardV2 style="width: 246px; height: 283px;">
        <ui:VisualElement name="layout-container" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; transition-property: translate; transition-duration: 0.2s;">
            <ui:VisualElement name="img-card-icon" style="position: absolute; left: 19px; top: 82px; width: 220px; height: 141px; background-image: url(&quot;project://database/Assets/Sprites/Cards/StaffAttacks/Staff_Queue_Icons/Staff%20Queue%20Icons/Focused_Strike.png?fileID=2800000&amp;guid=a34c4d771cecc3e40814a015e6e3b31d&amp;type=3#Focused_Strike&quot;);" />
            <ui:VisualElement name="img-card-back" class="card-back-s" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
            <ui:Label text="5" name="txt-speed" style="-unity-font: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/VT323-Regular.ttf?fileID=12800000&amp;guid=46b9139fed5cc6a42a6a5d42b82c3c7e&amp;type=3#VT323-Regular&quot;); -unity-font-definition: initial; font-size: 32px; position: absolute; left: 7px; top: 7px; width: 32px; height: 32px; -unity-text-align: upper-center; color: rgb(0, 0, 0);" />
            <ui:Label text="Focused Strike" name="txt-title" style="-unity-font: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/VT323-Regular.ttf?fileID=12800000&amp;guid=46b9139fed5cc6a42a6a5d42b82c3c7e&amp;type=3#VT323-Regular&quot;); -unity-font-definition: initial; font-size: 32px; position: absolute; left: 35px; top: 44px; width: 184px; height: 29px; -unity-text-align: upper-center; color: rgb(0, 0, 0);" />
            <ui:VisualElement name="img-stat-icon" class="stat-icon-def" style="width: 50px; height: 50px; position: absolute; top: 212px; left: 27px;" />
            <ui:VisualElement name="Textbox" style="flex-grow: 1; flex-direction: row; width: 110px; height: 30px; left: 110px; top: 219px; -unity-text-align: upper-left; align-self: auto; justify-content: center;">
                <ui:Label text="1" name="txt-stat-floor-outline" style="-unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/VT323-Regular.ttf?fileID=12800000&amp;guid=46b9139fed5cc6a42a6a5d42b82c3c7e&amp;type=3#VT323-Regular&quot;); font-size: 32px; -unity-font-style: bold; color: rgb(6, 255, 0); display: flex; visibility: visible; text-shadow: 0 0 0 rgb(0, 255, 43);">
                    <ui:Label text="1" name="txt-stat-floor" style="-unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/VT323-Regular.ttf?fileID=12800000&amp;guid=46b9139fed5cc6a42a6a5d42b82c3c7e&amp;type=3#VT323-Regular&quot;); font-size: 32px; -unity-font-style: normal; color: rgb(0, 0, 0);" />
                </ui:Label>
                <ui:Label text=" - " name="dash" style="-unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/VT323-Regular.ttf?fileID=12800000&amp;guid=46b9139fed5cc6a42a6a5d42b82c3c7e&amp;type=3#VT323-Regular&quot;); font-size: 32px; white-space: pre; width: auto;" />
                <ui:Label text="4" name="txt-stat-ceiling-outline" style="-unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/VT323-Regular.ttf?fileID=12800000&amp;guid=46b9139fed5cc6a42a6a5d42b82c3c7e&amp;type=3#VT323-Regular&quot;); font-size: 32px; color: rgb(255, 0, 0); -unity-font-style: bold; text-shadow: 0 0 0 rgb(255, 0, 0); -unity-text-outline-width: 0;">
                    <ui:Label text="4" name="txt-stat-ceiling" style="-unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/VT323-Regular.ttf?fileID=12800000&amp;guid=46b9139fed5cc6a42a6a5d42b82c3c7e&amp;type=3#VT323-Regular&quot;); font-size: 32px; color: rgb(0, 0, 0); -unity-font-style: normal;" />
                </ui:Label>
            </ui:VisualElement>
