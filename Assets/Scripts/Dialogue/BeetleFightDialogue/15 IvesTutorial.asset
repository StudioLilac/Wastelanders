%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 207ddad3e1c90594ba3f48e2a5a6a796, type: 3}
  m_Name: 15 IvesTutorial
  m_EditorClassIdentifier: 
  dialogue:
  - bodyText: Combat works the same as before, but now the enemy has more than one
      target.
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 87cb7c6c6588a4a3a957b707239abbf0, type: 3}
    broadcastAnEvent: 0
  - bodyText: "You can redirect an enemy\u2019s attack to yourself by clashing with
      it."
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 87cb7c6c6588a4a3a957b707239abbf0, type: 3}
    broadcastAnEvent: 0
  - bodyText: But <i>only if</i> your Action is faster than theirs.
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: b1411cc1e1231574797f223a58264863, type: 3}
    broadcastAnEvent: 0
  - bodyText: If no Clash forms, your Action was too slow to redirect the attack
      towards you.
    speakerName: Ives
    displayingImage: {fileID: -2991674613422419996, guid: 1e6cf2fca7138174e8f34bd44807fdc0, type: 3}
    broadcastAnEvent: 0
  - bodyText: 'But that <i>could</i> allow you to get an unopposed attack in. Guaranteeing
      that it hits. '
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 87cb7c6c6588a4a3a957b707239abbf0, type: 3}
    broadcastAnEvent: 0
  - bodyText: "And remember, we still can\u2019t play Actions with overlapping Speeds."
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: b1411cc1e1231574797f223a58264863, type: 3}
    broadcastAnEvent: 0
  - bodyText: "In a crowded fight, stepping into each other\u2019s timing can be
      fatal."
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 87cb7c6c6588a4a3a957b707239abbf0, type: 3}
    broadcastAnEvent: 0
  - bodyText: 'But once you get the hang of it, we can make openings more effectively
      than fighting alone. '
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 87cb7c6c6588a4a3a957b707239abbf0, type: 3}
    broadcastAnEvent: 0
  - bodyText: "Alright Jackie, let\u2019s crush these bugs!"
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 8dca0cf7dcae9ae4c831743a3edfdbbc, type: 3}
    broadcastAnEvent: 0
