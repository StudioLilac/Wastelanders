MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 207ddad3e1c90594ba3f48e2a5a6a796, type: 3}
  m_Name: 15 IvesTutorial
  m_EditorClassIdentifier: 
  dialogue:
  - bodyText: Combat works the same as before, but we can now cover for each other.
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 87cb7c6c6588a4a3a957b707239abbf0, type: 3}
    broadcastAnEvent: 0
  - bodyText: 'If an enemy is targetting you, I can redirect the Action to myself
      by playing a faster Action on top of their on-field icon. '
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: adfed2bb4f0eb4a47a0cbbec5e9170b0, type: 3}
    broadcastAnEvent: 0
  - bodyText: But remember, <i>only if</i> my Action is faster than theirs.
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: b1411cc1e1231574797f223a58264863, type: 3}
    broadcastAnEvent: 0
  - bodyText: Let's give it a shot.
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: adfed2bb4f0eb4a47a0cbbec5e9170b0, type: 3}
    broadcastAnEvent: 0
