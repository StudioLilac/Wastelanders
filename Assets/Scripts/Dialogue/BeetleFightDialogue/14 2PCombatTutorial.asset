  m_Script: {fileID: 11500000, guid: 207ddad3e1c90594ba3f48e2a5a6a796, type: 3}
  m_Name: 14 2PCombatTutorial
  m_EditorClassIdentifier: 
  dialogue:
  - bodyText: Alright, Jackie. This is your first time fighting alongside someone,
      right?
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 87cb7c6c6588a4a3a957b707239abbf0, type: 3}
    broadcastAnEvent: 0
  - bodyText: Yes!
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: 228f823fe8b2f4d4791ed74e46de81e1, type: 3}
    broadcastAnEvent: 0
  - bodyText: Good. Then listen closely, team fights work a little differently.
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 87cb7c6c6588a4a3a957b707239abbf0, type: 3}
    broadcastAnEvent: 0
  - bodyText: "First, you\u2019ll need to manage multiple hands."
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 87cb7c6c6588a4a3a957b707239abbf0, type: 3}
    broadcastAnEvent: 0
  - bodyText: <i>[Click]</i> on me to swap to my hand.
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 87cb7c6c6588a4a3a957b707239abbf0, type: 3}
    broadcastAnEvent: 0
