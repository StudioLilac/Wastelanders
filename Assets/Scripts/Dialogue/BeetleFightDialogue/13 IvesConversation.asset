  m_Script: {fileID: 11500000, guid: 207ddad3e1c90594ba3f48e2a5a6a796, type: 3}
  m_Name: 13 IvesConversation
  m_EditorClassIdentifier: 
  dialogue:
  - bodyText: What happened here, Ives?
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: 43e042f11549db840ae55c806d824b58, type: 3}
    broadcastAnEvent: 0
  - bodyText: Good timing Jackie, we could use your help right about now.
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 87cb7c6c6588a4a3a957b707239abbf0, type: 3}
    broadcastAnEvent: 0
  - bodyText: 'We think the Waste Products you examinees collected attracted the
      attention of these beetles. '
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 87cb7c6c6588a4a3a957b707239abbf0, type: 3}
    broadcastAnEvent: 0
  - bodyText: If you wouldn't mind, come help me out with clearing the beetles, would
      ya?
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 87cb7c6c6588a4a3a957b707239abbf0, type: 3}
    broadcastAnEvent: 0
  - bodyText: Sure!
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: c719baaafa8cd7148806ffb41907add6, type: 3}
    broadcastAnEvent: 0
