  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a4fafe43b89343e3a7ba1235e8987c0f, type: 3}
  m_Name: 16.5 CardsExhaustedV2
  m_EditorClassIdentifier: 
  Entries:
  - content: Here's my final tip.
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxId: 0
    picture: {fileID: 21300000, guid: 87cb7c6c6588a4a3a957b707239abbf0, type: 3}
    events: []
  - content: Careful about burning yourself out during a fight.
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxId: 0
    picture: {fileID: 21300000, guid: 87cb7c6c6588a4a3a957b707239abbf0, type: 3}
    events: []
  - content: You can play as many Actions as you want on your turn.
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxId: 0
    picture: {fileID: 21300000, guid: 26e9e78366004814eb04d15ac70b48af, type: 3}
    events: []
  - content: But each time your deck is exhausted and reshuffles...
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxId: 0
    picture: {fileID: 21300000, guid: 26e9e78366004814eb04d15ac70b48af, type: 3}
    events: []
  - content: 'Your maximum hand size will be decreased by one for the rest of the
      fight! '
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxId: 0
    picture: {fileID: 21300000, guid: 26e9e78366004814eb04d15ac70b48af, type: 3}
    events: []
  - content: 'So make every Action count to avoid exhausting yourself too quickly! '
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxId: 0
    picture: {fileID: 21300000, guid: 87cb7c6c6588a4a3a957b707239abbf0, type: 3}
    events: []
  references:
    version: 2
    RefIds: []
