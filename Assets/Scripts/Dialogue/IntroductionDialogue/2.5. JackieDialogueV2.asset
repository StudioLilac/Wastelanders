  m_Name: 2.5. JackieDialogueV2
  m_EditorClassIdentifier: 
  Entries:
  - content: "Well... Today\u2019s the day I\u2019ve been preparing for."
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxName: 
    picture: {fileID: 0}
    events:
    - rid: 1207052918024306752
    - rid: 1207052918024306769
    - rid: 1207052918024306755
    - rid: 1207052918024306753
  - content: "It\u2019s been a year. I won't fail this again."
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxName: 
    picture: {fileID: 0}
    events:
    - rid: 1207052918024306756
  - content: 'I will make it to those Wasteland expeditions. Mama is counting on
      me. '
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxName: 
    picture: {fileID: 0}
    events:
    - rid: 1207052918024306757
