%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 207ddad3e1c90594ba3f48e2a5a6a796, type: 3}
  m_Name: 11. OpponentCard
  m_EditorClassIdentifier: 
  dialogue:
  - bodyText: "Enough warm-up. Let\u2019s get serious."
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: ade9660133ca00a499bfa3ad449b87bd, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: "When fighting an enemy that fights back, you\u2019ll see the Action
      they\u2019re preparing next to them."
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: fbdbcaab28794334bb84176f7e052fb5, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: "At the top of its icon, you\u2019ll see their Target and Power range."
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: edb0bc1d86401ce4aadfe4358f987ea3, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: Hovering over the icon allows you to view more details like Abilities
      and Speed.
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 400ae0b25c96b3f48a991679eb1b7bde, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: Their Action also appears in the battle queue too.
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: fbdbcaab28794334bb84176f7e052fb5, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: 'Now, read my attacks and make your move. Your first attack will be
      played against mine. '
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: ade9660133ca00a499bfa3ad449b87bd, type: 3}
    sfx: 
    broadcastAnEvent: 0
