--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 207ddad3e1c90594ba3f48e2a5a6a796, type: 3}
  m_Name: 16. CardsExhausted
  m_EditorClassIdentifier: 
  dialogue:
  - bodyText: Here's my final tip.
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 87cb7c6c6588a4a3a957b707239abbf0, type: 3}
    broadcastAnEvent: 0
  - bodyText: Careful about burning yourself out during a fight.
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 87cb7c6c6588a4a3a957b707239abbf0, type: 3}
    broadcastAnEvent: 0
  - bodyText: You can play as many Actions as you want on your turn.
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 26e9e78366004814eb04d15ac70b48af, type: 3}
    broadcastAnEvent: 0
  - bodyText: But each time your deck is exhausted and reshuffles...
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 26e9e78366004814eb04d15ac70b48af, type: 3}
    broadcastAnEvent: 0
  - bodyText: 'Your maximum hand size will be decreased by one for the rest of the
      fight! '
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 26e9e78366004814eb04d15ac70b48af, type: 3}
    broadcastAnEvent: 0
  - bodyText: 'So make every Action count to avoid exhausting yourself too quickly! '
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 87cb7c6c6588a4a3a957b707239abbf0, type: 3}
    broadcastAnEvent: 0
