  dialogue:
  - bodyText: "While using a staff, you\u2019ll often see the buff <i>Flow</i> being
      mentioned."
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 820631014ce088c4cb748224d5467c86, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: '<i>[Hover]</i> over the <i>Flow</i> icon underneath yourself to learn
      more about it from the <i>Tooltip</i>. '
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 820631014ce088c4cb748224d5467c86, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: Each weapon has its own unique mechanic. Learn them to create some
      devastating synergies in battle.
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 820631014ce088c4cb748224d5467c86, type: 3}
