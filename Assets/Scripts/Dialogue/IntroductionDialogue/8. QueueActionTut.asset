  m_Script: {fileID: 11500000, guid: 207ddad3e1c90594ba3f48e2a5a6a796, type: 3}
  m_Name: 8. QueueActionTut
  m_EditorClassIdentifier: 
  dialogue:
  - bodyText: Targeting an enemy adds the Action to the battle queue.
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: d960aa6e94a2c924badfb0dae38bc9b4, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: The queue is sorted by Speed, with the fastest Action on the left.
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: b1411cc1e1231574797f223a58264863, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: You can [Hover] over a queued card's icon to check its stats again.
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 57baba5992d9e224988e93fcacf9f7eb, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: Or [Left Click] it to retrieve it back into your hand.
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 57baba5992d9e224988e93fcacf9f7eb, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: Lets try retrieving that Action from the queue back to our hand!
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 57baba5992d9e224988e93fcacf9f7eb, type: 3}
    sfx: 
    broadcastAnEvent: 0
