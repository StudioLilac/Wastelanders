  m_Script: {fileID: 11500000, guid: 207ddad3e1c90594ba3f48e2a5a6a796, type: 3}
  m_Name: 9. RollDiceTut
  m_EditorClassIdentifier: 
  dialogue:
  - bodyText: Remember how Power always falls within a range?
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 1b3241f349d62e84682b58beac0b94cb, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: 'During combat, the actual power is rolled randomly within that range. '
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 1b3241f349d62e84682b58beac0b94cb, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: Dealing that amount of damage on hit.
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 1b3241f349d62e84682b58beac0b94cb, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: "When you're ready, [Click] anywhere to roll your attack\u2019s Power."
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 05aec2f8237521d4f84b7c3d335550b0, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: "Let\u2019s see how much force you can muster."
    speakerName: Ives
    displayingImage: {fileID: 21300000, guid: 1b3241f349d62e84682b58beac0b94cb, type: 3}
    sfx: 
    broadcastAnEvent: 0
