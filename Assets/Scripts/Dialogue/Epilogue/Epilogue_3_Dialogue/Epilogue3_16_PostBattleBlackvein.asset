  m_Script: {fileID: 11500000, guid: a4fafe43b89343e3a7ba1235e8987c0f, type: 3}
  m_Name: Epilogue3_16_PostBattleBlackvein
  m_EditorClassIdentifier: 
  Entries:
  - content: "It\u2019s... blackvein..."
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 6570561780457144486
    - rid: 6570561780457144487
    - rid: 6570561780457144488
    - rid: 6570561780457144489
    - rid: 6570561780457144490
    - rid: 6570561780457144491
  - content: "Everyone! We\u2019ve gotta get her back to the city. These serums are
      dangerous until we figure out what\u2019s going on."
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 6570561780457144493
  - content: But now that the frog is gone, all the monsters are running wild! How
      are we going to get back like this?
    speaker: {fileID: 11400000, guid: 4be3841f8f6da4f3ca84917932aa6724, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 6570561780457144494
  - content: "Don\u2019t worry, if what Cam said about replicating powers is true,
      we\u2019ll be fine."
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 6570561780457144495
    - rid: 6570561780457144496
