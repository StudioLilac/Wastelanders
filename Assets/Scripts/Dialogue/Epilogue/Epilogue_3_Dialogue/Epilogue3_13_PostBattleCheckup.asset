  m_Script: {fileID: 11500000, guid: a4fafe43b89343e3a7ba1235e8987c0f, type: 3}
  m_Name: Epilogue3_13_PostBattleCheckup
  m_EditorClassIdentifier: 
  Entries:
  - content: <i>Jackie and Ives approach the dazed beetles and revert them back to
      NITES.
    speaker: {fileID: 11400000, guid: 9eb64e5cd0fdbe944b654af85100bcb6, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events: []
  - content: That experience was... terrifying. As if I was a spectator to my own
      body.
    speaker: {fileID: 11400000, guid: 17e4d93cc7e3a054e9cf5f1e74be615a, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 7570221480750350398
    - rid: 7570221480750350399
    - rid: 7570221480750350400
  - content: 'If it wern''t for your quick thinking, who knows what would''ve happened. '
    speaker: {fileID: 11400000, guid: 4be3841f8f6da4f3ca84917932aa6724, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 6570561780457144436
  - content: "You would have done the same for me. I\u2019m glad you\u2019re all
      okay."
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 6570561780457144437
    - rid: 6570561780457144438
    - rid: 6570561780457144440
    - rid: 6570561780457144441
    - rid: 6570561780457144442
  - content: Ives, your arm. The Waste is already beginning to seep in. You need
      your serum, now.
    speaker: {fileID: 11400000, guid: 17e4d93cc7e3a054e9cf5f1e74be615a, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events: []
  - content: Here.
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxId: 0
    picture: {fileID: 21300000, guid: f29addafedd7075418d577a938699eee, type: 3}
    events: []
