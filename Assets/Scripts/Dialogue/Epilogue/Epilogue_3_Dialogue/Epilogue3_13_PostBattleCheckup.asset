  m_Script: {fileID: 11500000, guid: a4fafe43b89343e3a7ba1235e8987c0f, type: 3}
  m_Name: Epilogue3_13_PostBattleCheckup
  m_EditorClassIdentifier: 
  Entries:
  - content: "Thank you Jackie... for freeing us. That was terrifying. I couldn\u2019t
      control my own body."
    speaker: {fileID: 11400000, guid: 4be3841f8f6da4f3ca84917932aa6724, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 6570561780457144435
  - content: Quick thinking! You saved all of us out there.
    speaker: {fileID: 11400000, guid: 4be3841f8f6da4f3ca84917932aa6724, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 6570561780457144436
  - content: "You would have done the same for me. I\u2019m glad you\u2019re all
      okay."
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 6570561780457144437
    - rid: 6570561780457144438
    - rid: 6570561780457144439
    - rid: 6570561780457144440
    - rid: 6570561780457144441
    - rid: 6570561780457144442
  - content: "Ives! Your arm! The Waste is already beginning to seep in. Where\u2019s
      your serum? You need it, now!"
    speaker: {fileID: 11400000, guid: 4be3841f8f6da4f3ca84917932aa6724, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 6570561780457144443
  - content: Here.
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 6570561780457144444
    - rid: 6570561780457144445
    - rid: 6570561780457144446
    - rid: 6570561780457144447
    - rid: 6570561780457144448
    - rid: 6570561780457144449
  - content: "We\u2019ll take care of you, Captain."
    speaker: {fileID: 11400000, guid: 4be3841f8f6da4f3ca84917932aa6724, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 6570561780457144450
  - content: 
    speaker: {fileID: 11400000, guid: 4fef3aeb65460fd498ab9efe9bac8625, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 6570561780457144451
    - rid: 6570561780457144452
