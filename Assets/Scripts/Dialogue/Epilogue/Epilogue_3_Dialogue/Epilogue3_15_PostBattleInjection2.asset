  m_Script: {fileID: 11500000, guid: a4fafe43b89343e3a7ba1235e8987c0f, type: 3}
  m_Name: Epilogue3_15_PostBattleInjection2
  m_EditorClassIdentifier: 
  Entries:
  - content: HOLD IT.
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 6570561780457144461
    - rid: 6570561780457144462
    - rid: 6570561780457144463
    - rid: 6570561780457144464
    - rid: 6570561780457144465
    - rid: 6570561780457144466
  - content: <i>The needle tumbles in the dirt as it is batted off to the side by
      Jackie.</i>
    speaker: {fileID: 11400000, guid: 9eb64e5cd0fdbe944b654af85100bcb6, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 6570561780457144467
  - content: Ives, was the serum always this colour?
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 6570561780457144468
    - rid: 6570561780457144469
  - content: No... never seen that before.
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 6570561780457144471
    - rid: 6570561780457144472
    - rid: 6570561780457144475
    - rid: 6570561780457144476
    - rid: 6570561780457144477
    - rid: 6570561780457144478
  - content: "What about everyone else\u2019s serum? What colour are they?"
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 6570561780457144473
    - rid: 6570561780457144474
  - content: Mine seems to have turned pink too.
    speaker: {fileID: 11400000, guid: 4be3841f8f6da4f3ca84917932aa6724, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 6570561780457144479
  - content: "Yeah, same here, though mine\u2019s not as dark. "
    speaker: {fileID: 11400000, guid: 4be3841f8f6da4f3ca84917932aa6724, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 6570561780457144479
  - content: Dammit. Ives, are you feeling alright?
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 6570561780457144480
    - rid: 6570561780457144481
  - content: Argh, I feel like... something is about to burst out of my arm.
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 6570561780457144482
    - rid: 6570561780457144483
  - content: 
    speaker: {fileID: 11400000, guid: 4fef3aeb65460fd498ab9efe9bac8625, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 6570561780457144484
    - rid: 6570561780457144485
