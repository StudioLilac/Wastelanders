  m_Script: {fileID: 11500000, guid: a4fafe43b89343e3a7ba1235e8987c0f, type: 3}
  m_Name: Epilogue9_7_TundraWeiss
  m_EditorClassIdentifier: 
  Entries:
  - content: That mountain is like a haystack, Ives. Even with the coordinates, if
      she's deep in the tunnels...
    speaker: {fileID: 11400000, guid: 275918e912c757f4ab1b228eefee6401, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095765763391693
    - rid: 314095765763391686
    - rid: 314095765763391687
    - rid: 314095765763391688
    - rid: 314095765763391689
    - rid: 314095765763391690
  - content: "I know. That\u2019s why I\u2019ll let her know we\u2019re here."
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095765763391692
    - rid: 314095765763391691
  - content: How?
    speaker: {fileID: 11400000, guid: 275918e912c757f4ab1b228eefee6401, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095765763391694
    - rid: 314095765763391695
  - content: <i>Ives activates her transformation, shifting into the royal form of
      the Princess Frog.</i>
    speaker: {fileID: 11400000, guid: 9eb64e5cd0fdbe944b654af85100bcb6, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095765763391696
  - content: "If she\u2019s using your tracker, she\u2019ll see this blip."
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095765763391697
