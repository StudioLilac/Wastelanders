  m_Script: {fileID: 11500000, guid: a4fafe43b89343e3a7ba1235e8987c0f, type: 3}
  m_Name: Epilogue9_7_TundraWeiss
  m_EditorClassIdentifier: 
  Entries:
  - content: Ives, if she's deep in these caves, how are we supposed to find her?
    speaker: {fileID: 11400000, guid: 0c67bccb77acb478ca9abb7f55cabc38, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095765763391693
    - rid: 314095765763391689
    - rid: 314095765763391688
    - rid: 314095765763391690
    - rid: 8385543117129122106
  - content: "We'll let her know we\u2019re here. Hopefully, she'll let us know where
      to find her."
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095765763391692
    - rid: 314095765763391691
  - content: How?
    speaker: {fileID: 11400000, guid: 0c67bccb77acb478ca9abb7f55cabc38, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events: []
  - content: <i>Ives activates her transformation, shifting into the royal form of
      the Princess Frog.</i>
    speaker: {fileID: 11400000, guid: 9eb64e5cd0fdbe944b654af85100bcb6, type: 2}
    sfxId: 504
    picture: {fileID: 0}
    events:
    - rid: 8385543117129122107
