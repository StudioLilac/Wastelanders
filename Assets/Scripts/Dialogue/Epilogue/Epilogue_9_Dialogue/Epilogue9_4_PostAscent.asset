%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a4fafe43b89343e3a7ba1235e8987c0f, type: 3}
  m_Name: Epilogue9_4_PostAscent
  m_EditorClassIdentifier: 
  Entries:
  - content: "We're here, the coordinates for Delta\u2019s last signal."
    speaker: {fileID: 11400000, guid: e1d6a8a99977249eb89967ed128a714c, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095765763391621
    - rid: 314095765763391638
    - rid: 314095765763391622
    - rid: 314095765763391623
    - rid: 314095765763391637
  - content: '<i>The company slows and raises their lights to scan the area.</i> '
    speaker: {fileID: 11400000, guid: 9eb64e5cd0fdbe944b654af85100bcb6, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events: []
  - content: Looks like our luck has run out. Just like they said, solid rock.
    speaker: {fileID: 11400000, guid: ba10bd187431a442890fc8138cfaa1e2, type: 2}
    sfxId: 560
    picture: {fileID: 0}
    events: []
  - content: Ari, what do you mean?
    speaker: {fileID: 11400000, guid: e1d6a8a99977249eb89967ed128a714c, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095765763391624
    - rid: 314095765763391630
  - content: I mean, look at it. Smooth as butter, solid as ice.
    speaker: {fileID: 11400000, guid: ba10bd187431a442890fc8138cfaa1e2, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095765763391628
  - content: ...Ari. Put your hand down. There's no wall there.
    speaker: {fileID: 11400000, guid: e1d6a8a99977249eb89967ed128a714c, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095765763391629
    - rid: 8385543117129122093
  - content: Ha... Good joke, boss. It's right there!
    speaker: {fileID: 11400000, guid: ba10bd187431a442890fc8138cfaa1e2, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095765763391632
  - content: <i>A murmur spreads through the group. One half gestures, the other
      meets them with furrowed faces.</i>
    speaker: {fileID: 11400000, guid: 9eb64e5cd0fdbe944b654af85100bcb6, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095765763391634
  - content: "Look it\u2019s just a bit of a squeeze, there\u2019s really nothing
      here."
    speaker: {fileID: 11400000, guid: e1d6a8a99977249eb89967ed128a714c, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095765763391633
  - content: <i>Jay starts into the tunnel entrance, Ari flinches.</i>
    speaker: {fileID: 11400000, guid: 9eb64e5cd0fdbe944b654af85100bcb6, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 8385543117129122098
  - content: "<i>Ari reaches out, but then stops himself as Jay makes his way through.
      Ari\u2019s face contorts as it happens.</i>"
    speaker: {fileID: 11400000, guid: 9eb64e5cd0fdbe944b654af85100bcb6, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events: []
  - content: See? It's safe! Come on!
    speaker: {fileID: 11400000, guid: e1d6a8a99977249eb89967ed128a714c, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095765763391636
    - rid: 314095765763391649
    - rid: 8385543117129122095
  - content: "What the hell\u2014"
    speaker: {fileID: 11400000, guid: ba10bd187431a442890fc8138cfaa1e2, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 8385543117129122096
