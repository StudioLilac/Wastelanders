  m_Script: {fileID: 11500000, guid: a4fafe43b89343e3a7ba1235e8987c0f, type: 3}
  m_Name: InFightHint
  m_EditorClassIdentifier: 
  Entries:
  - content: Careful Jackie, Ives injection is decohering her. You'll have to manage
      her dissonance levels during the fight.
    speaker: {fileID: 11400000, guid: 2f83f78016c814045855f5b9c9f437fa, type: 2}
    sfxId: 0
    picture: {fileID: 21300000, guid: 2caf95be9f6226f499e3bf32627a2d21, type: 3}
    events: []
  - content: Got it. What should I look out for?
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxId: 0
    picture: {fileID: 21300000, guid: 88a7e4552c1afa641acadc54e9b6cbac, type: 3}
    events: []
  - content: '<i>Dissonance: Upper bound of an Action''s power decreases by 1 per
      stack. If stacks exceeds the host''s current HP, kills them immediately.</i>'
    speaker: {fileID: 11400000, guid: b64e232132ef228439856328530fa3c8, type: 2}
    sfxId: 0
    picture: {fileID: 21300000, guid: 5074e141eda7e4f478766c386d5a129e, type: 3}
    events: []
  - content: '<i>Decohering: When Ives takes damage, gain 1 stack of Dissonance.
      When Ives deals damage, lose 1 stack of Dissonance. If Ives dies, the fight
      is lost.</i>'
    speaker: {fileID: 11400000, guid: b64e232132ef228439856328530fa3c8, type: 2}
    sfxId: 0
    picture: {fileID: 21300000, guid: f921bbc86c0e6b944a4b0b27be572332, type: 3}
    events: []
  - content: Okay. Let's do this.
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxId: 0
    picture: {fileID: 21300000, guid: 88a7e4552c1afa641acadc54e9b6cbac, type: 3}
    events: []
  references:
    version: 2
    RefIds: []
