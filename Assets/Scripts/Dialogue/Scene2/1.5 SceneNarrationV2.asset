  m_Name: 1.5 SceneNarrationV2
  m_EditorClassIdentifier: 
  Entries:
  - content: "<i>After a day's worth of traveling, the Candidates arrive at The Western
      Marsh, this year\u2019s exam destination.</i>"
    speaker: {fileID: 11400000, guid: 9eb64e5cd0fdbe944b654af85100bcb6, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events: []
  - content: <i>They spend the night setting up base camp. Tension fills the camp,
      and Candidates are restless throughout the night.</i>
    speaker: {fileID: 11400000, guid: 9eb64e5cd0fdbe944b654af85100bcb6, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events: []
  - content: <i>Finally, the morning of the exam arrives.</i>
    speaker: {fileID: 11400000, guid: 9eb64e5cd0fdbe944b654af85100bcb6, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events: []
  references:
    version: 2
    RefIds: []
