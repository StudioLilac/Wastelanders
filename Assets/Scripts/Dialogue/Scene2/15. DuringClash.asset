  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a4fafe43b89343e3a7ba1235e8987c0f, type: 3}
  m_Name: 15. DuringClash
  m_EditorClassIdentifier: 
  Entries:
  - content: When two Actions Clash, they resolve at the speed of the faster one.
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxName: 
    picture: {fileID: 0}
    events: []
  - content: Both Actions roll their Power at the same time.
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxName: 
    picture: {fileID: 0}
    events: []
  - content: Whoever rolls higher wins the exchange, dealing their full Power to
      the loser.
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxName: 
    picture: {fileID: 0}
    events: []
  - content: "The loser\u2019s attack is <i>staggered</i>, dealing nothing in return.
      It may even fail to trigger its abilities."
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxName: 
    picture: {fileID: 0}
    events: []
  - content: Take this!
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxName: 
    picture: {fileID: 0}
    events: []
  references:
    version: 2
    RefIds: []
