  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a4fafe43b89343e3a7ba1235e8987c0f, type: 3}
  m_Name: 18. ExplainDefense
  m_EditorClassIdentifier: 
  Entries:
  - content: This Action is dangerous, if I don't beat it in a Clash and stagger
      it, something dangerous will happen.
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxName: 
    picture: {fileID: 21300000, guid: 78ba18018c7a46446b97ffd2d9388f16, type: 3}
    events: []
  - content: 'This Action is also a Defensive Action, as marked by the shield icon. '
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxName: 
    picture: {fileID: 21300000, guid: 926dc102ee6ad62488fa7f3605a127ce, type: 3}
    events: []
  - content: 'Its Power subtracts any incoming damage, even if it loses a Clash. '
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxName: 
    picture: {fileID: 21300000, guid: 926dc102ee6ad62488fa7f3605a127ce, type: 3}
    events: []
  - content: "I've got a couple Actions like those too, if I can\u2019t win a Clash,
      a Defensive Action can still protect me."
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxName: 
    picture: {fileID: 21300000, guid: 62a5b4fbc5876444fb619a037b27da7b, type: 3}
    events: []
  - content: 'Let''s make sure this Action doesn''t go through though. '
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxName: 
    picture: {fileID: 21300000, guid: 78ba18018c7a46446b97ffd2d9388f16, type: 3}
    events: []
  references:
    version: 2
    RefIds: []
