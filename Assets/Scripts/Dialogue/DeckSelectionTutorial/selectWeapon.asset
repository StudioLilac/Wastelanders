  dialogue:
  - bodyText: "Hmm\u2026 I should be able to utilize two weapons in a fight."
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: 88a7e4552c1afa641acadc54e9b6cbac, type: 3}
    broadcastAnEvent: 0
  - bodyText: I already have my staff with me.
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: 8afd99f3c1b9d4147adaff1c9e70de1f, type: 3}
    broadcastAnEvent: 0
  - bodyText: "And since I\u2019ve been training hard to use the pistol recently,
      I should bring that to my exam."
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: d02ee8fb57f58fb4ead2d8e5688dd87a, type: 3}
    broadcastAnEvent: 0
  - bodyText: <i>[Click] on the weapon to select it and bring it into combat.</i>
    speakerName: Tutorial
    displayingImage: {fileID: 21300000, guid: d02ee8fb57f58fb4ead2d8e5688dd87a, type: 3}
