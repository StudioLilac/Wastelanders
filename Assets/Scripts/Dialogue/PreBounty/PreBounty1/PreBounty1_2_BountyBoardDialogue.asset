%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a4fafe43b89343e3a7ba1235e8987c0f, type: 3}
  m_Name: PreBounty1_2_BountyBoardDialogue
  m_EditorClassIdentifier: 
  Entries:
  - content: "You\u2019ve been standing there for quite some time, kid."
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095657258319952
  - content: Ives. How long have you been here?
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095657258319951
    - rid: 314095657258319958
    - rid: 314095657258319962
  - content: "Long enough. Thought I\u2019d give you some space."
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095657258319950
    - rid: 314095657258319959
    - rid: 314095657258319960
    - rid: 314095657258319961
  - content: "They\u2019re finally reopening the Tundra. Wasn\u2019t it closed for
      being too contaminated to traverse? What do you know about it?"
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095657258319949
    - rid: 314095657258319972
  - content: "The whole operation was Cam\u2019s idea. He\u2019s been burning the
      midnight oil to get approval for his \u201Csafe\u201D Wasteland traversing
      invention. "
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095657258319948
    - rid: 314095657258319963
  - content: "An invention that can help us cross the Tundra! Now\u2019s finally
      our chance to find out what happened during Mama\u2019s \u2019trip\u2019. "
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095657258319947
    - rid: 314095657258319964
  - content: "Yep. That\u2019s why I\u2019ll be taking the first team out. "
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095657258319946
    - rid: 314095657258319965
  - content: "Then I\u2019m coming with you."
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095657258319945
    - rid: 314095657258319966
  - content: But... how did Cam do it? The Tundra has been off-limits for years.
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095657258319944
    - rid: 314095657258319967
  - content: "Heck if I can explain it right. As long as we get out there, it\u2019s
      good enough for me."
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095657258319943
    - rid: 314095657258319968
  - content: "You should go see him before we ship out. I\u2019ll make sure you\u2019re
      on my list in the meantime."
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095657258319942
    - rid: 314095657258319969
  - content: Thanks, Ives.
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095657258319941
    - rid: 314095657258319970
  - content: "We\u2019re gonna find out what happened out there, kid. I promise."
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095657258319940
    - rid: 314095657258319971
  - content: The mentor and mentee bump fists, a conduit of smoldering resolve.
    speaker: {fileID: 11400000, guid: 9eb64e5cd0fdbe944b654af85100bcb6, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095657258319939
  references:
    version: 2
