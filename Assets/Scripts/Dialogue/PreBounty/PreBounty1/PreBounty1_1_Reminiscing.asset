  m_Script: {fileID: 11500000, guid: a4fafe43b89343e3a7ba1235e8987c0f, type: 3}
  m_Name: PreBounty1_1_Reminiscing
  m_EditorClassIdentifier: 
  Entries:
  - content: <i>After a decade of closure due to unresolved NITES disappearances,
      the Tundra re-opens for active research expeditions.</i>
    speaker: {fileID: 11400000, guid: a9924d74021fb49d796b34e9cd8d18a3, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095657258319938
  - content: <i>Leading scientific experts now theorize the volatile region was ground
      zero for a massive meteor strike. </i>
    speaker: {fileID: 11400000, guid: a9924d74021fb49d796b34e9cd8d18a3, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095657258319938
  - content: <i>Qualified personnel proficient in Waste Crystal extractions instructed
      to contact the head office for immediate details.</i>
    speaker: {fileID: 11400000, guid: a9924d74021fb49d796b34e9cd8d18a3, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095657258319938
  - content: It finally worked...
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events:
    - rid: 314095657258319953
    - rid: 314095657258319955
    - rid: 314095657258319956
  - content: 'All the research and convincing I did. They actually listened. '
    speaker: {fileID: 11400000, guid: e9d3865c367188f4f99c47e692b92911, type: 2}
    sfxId: 0
    picture: {fileID: 0}
    events: []
