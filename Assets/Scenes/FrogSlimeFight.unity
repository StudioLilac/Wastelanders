  frog2WalkIn: {fileID: 561866396}
  pound: {fileID: 7445010627441748703, guid: 41158511bc5761d4386617623a2a562d, type: 3}
  firstTutorialSlime: {fileID: 1360125393}
  slimeStack: {fileID: 1941868523}
  slimeBattle: {fileID: 1422898870}
  slimeWalkIn: {fileID: 808288517}
  mainCamera: {fileID: 1525248175}
  mainBrain: {fileID: 1525248177}
  scoutBeetlePrefab: {fileID: 8044949296705636452, guid: 692030d7a70f84e1e9949eb9b07ebce5, type: 3}
  closeUpCamera: {fileID: 811157971}
  startingCamera: {fileID: 965254509}
  baseCamera: {fileID: 537786514}
  dynamicCamera: {fileID: 1542478170}
  marshBG: {fileID: 189897196}
  ivesProfile: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
  treeOverlay: {fileID: 1424525370}
  closeTrees:
  - {fileID: 1487316981}
  - {fileID: 1424525371}
  frogDeathSprite: {fileID: 21300000, guid: 87829d35cc4de8b4db02b857e0431956, type: 3}
  jackieHoldingCrystalSprite: {fileID: 21300000, guid: 39aee1878ca221043839f79d83a21ecd, type: 3}
  startingNarration:
  - content: "After a day's worth of traveling, the Candidates arrive at The Western
      Marsh, this year\u2019s exam destination."
    speaker: {fileID: 11400000, guid: 9eb64e5cd0fdbe944b654af85100bcb6, type: 2}
    sfxName: 
    picture: {fileID: 0}
    events: []
  - content: They spend the night setting up base camp. Tension fills the camp, and
      Candidates are restless throughout the night.
    speaker: {fileID: 11400000, guid: 9eb64e5cd0fdbe944b654af85100bcb6, type: 2}
    sfxName: 
    picture: {fileID: 0}
    events: []
  - content: Finally, the morning of the exam arrives.
    speaker: {fileID: 11400000, guid: 9eb64e5cd0fdbe944b654af85100bcb6, type: 2}
    sfxName: 
    picture: {fileID: 0}
    events: []
  testBegins:
  - content: Good morning, Candidates. As you all know...
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxName: 
    picture: {fileID: 0}
    events:
    - rid: 5589630762363650048
    - rid: 5589630762363650049
    - rid: 5589630762363650053
    - rid: 5589630762363650050
  - content: This exam will emulate a real NITES wasteland expedition.
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxName: 
    picture: {fileID: 0}
    events:
    - rid: 5589630762363650057
  - content: The purpose of these expeditions are to extract as much valuable Waste
      Products that cultivate inside mutated creatures as we can.
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxName: 
    picture: {fileID: 0}
    events: []
  - content: 'These Products are essential to combat the spread of the Waste as they
      help us produce weapons and energy. '
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxName: 
    picture: {fileID: 0}
    events: []
  - content: 'As such, this exam will test your ability to exploit and extract as
      many valuable Waste Products from the local flora and fauna as you can. '
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxName: 
    picture: {fileID: 0}
    events: []
  - content: 'The examiners will be discreetly evaluating you, and will not interfere
      with the exam unless there is a serious emergency. '
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxName: 
    picture: {fileID: 0}
    events: []
  - content: You have until noon tomorrow to collect as many valuable Waste Products
      as you can.
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxName: 
    picture: {fileID: 0}
    events:
    - rid: 5589630762363650058
  - content: Good luck, your time starts now.
    speaker: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
    sfxName: 
    picture: {fileID: 0}
    events:
    - rid: 5589630802696863808
  jackieStrategyPlan:
  - bodyText: Hmm, what's my plan...
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: 228f823fe8b2f4d4791ed74e46de81e1, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: Killing more dangerous Waste Creatures drop better Waste Products.
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: 228f823fe8b2f4d4791ed74e46de81e1, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: Should I work with a team again to hunt down a larger waste monster?
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: 228f823fe8b2f4d4791ed74e46de81e1, type: 3}
    sfx: 
    broadcastAnEvent: 1
  - bodyText: 'No, I came back almost empty-handed last year after I froze up and
      let others do the fighting. '
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: 537908265661f2b44970c526d7724cfb, type: 3}
    sfx: 
    broadcastAnEvent: 1
  - bodyText: By the time I felt okay, there were basically no products left!
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: 487226e5dae66424ea250466920a3086, type: 3}
    sfx: 
    broadcastAnEvent: 1
  - bodyText: "I can do this solo, that\u2019s what the past year of training was
      for."
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: 228f823fe8b2f4d4791ed74e46de81e1, type: 3}
    sfx: 
    broadcastAnEvent: 1
  - bodyText: 'This way I get the full cut of the products, and it should impress
      the examiners, I hope. '
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: c719baaafa8cd7148806ffb41907add6, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: "Although I\u2019ll have to be sneaky and careful if I\u2019m hunting
      alone..."
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: 487226e5dae66424ea250466920a3086, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: <i>Squelch
    speakerName: Slime
    displayingImage: {fileID: 21300000, guid: 174956c54b12b0d419353cc1a44153ca, type: 3}
    sfx: 
    broadcastAnEvent: 1
  - bodyText: Whoops. Maybe I gotta be more sneaky and more careful.
    speakerName: Slime
    displayingImage: {fileID: 21300000, guid: 228f823fe8b2f4d4791ed74e46de81e1, type: 3}
    sfx: 
    broadcastAnEvent: 0
  explainEnemyAttacks: {fileID: 11400000, guid: bd119768af500824888c7433c16c4b43, type: 2}
  explainClashing: {fileID: 11400000, guid: fbf4a51513cbf2d40b41e0d798bda07a, type: 2}
  duringClashing: {fileID: 11400000, guid: 3c3d75708099ea94588e98cc21104637, type: 2}
  afterClashing: {fileID: 11400000, guid: e43c59909903d5845b7fe39f7f9c788f, type: 2}
  afterFirstCombat: {fileID: 11400000, guid: 69ee7ad9a8d07f4499fe27b8283e009d, type: 2}
  defensiveCardsTutorial: {fileID: 11400000, guid: 882b677f5e18fa248be0b4625dd70abb, type: 2}
  andNowWeWait:
  - bodyText: 'And now, we wait. '
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: 228f823fe8b2f4d4791ed74e46de81e1, type: 3}
    sfx: 
    broadcastAnEvent: 0
  jackiePreMissedShot:
  - bodyText: "Well, it\u2019s not the strongest monster, but I\u2019ve got to start
      collecting Waste Products. I can't fall behind."
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: 537908265661f2b44970c526d7724cfb, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: <i>Jackie steadies her breathing and takes aim.
    speakerName: Narration
    displayingImage: {fileID: 0}
    sfx: 
    broadcastAnEvent: 0
  jackiePostMissedShot:
  - bodyText: Crap, I missed. Guess I'll take it down by force.
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: 537908265661f2b44970c526d7724cfb, type: 3}
    sfx: 
    broadcastAnEvent: 0
  jackiePreCombat:
  - bodyText: 'Well... the more the merrier. '
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: 537908265661f2b44970c526d7724cfb, type: 3}
    sfx: 
    broadcastAnEvent: 0
  startOfCombatDialogue:
  - bodyText: Guess I got the fight I wanted.
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: 228f823fe8b2f4d4791ed74e46de81e1, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: "These Actions are new let\u2019s see what these guys are planning
      to do."
    speakerName: Jackie
    displayingImage: {fileID: 6229163501658965789, guid: 4348d265f2f0fb04387b39ac7ca78c63, type: 3}
    sfx: 
    broadcastAnEvent: 0
  afterCombatDialogue:
  - bodyText: Whew, glad thats over and done with.
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: 228f823fe8b2f4d4791ed74e46de81e1, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: "Let\u2019s see what Waste Products these monsters had in them."
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: c719baaafa8cd7148806ffb41907add6, type: 3}
    sfx: 
    broadcastAnEvent: 0
  crystalExtraction:
  - bodyText: 'Ew, alright. No wonder it was hacking up so much spit. '
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: 537908265661f2b44970c526d7724cfb, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: 'I wonder how this crystal got in here? '
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: 228f823fe8b2f4d4791ed74e46de81e1, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: Heh, looks pretty valuable though. Not a bad start.
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: c719baaafa8cd7148806ffb41907add6, type: 3}
    sfx: 
    broadcastAnEvent: 0
  - bodyText: Off to the next target!
    speakerName: Jackie
    displayingImage: {fileID: 21300000, guid: c719baaafa8cd7148806ffb41907add6, type: 3}
    sfx: 
    broadcastAnEvent: 0
  beetleEntrance:
  - bodyText: KCCRRKR?
    speakerName: ???
    displayingImage: {fileID: 21300000, guid: 320fd4765facdcb488b31229396fad33, type: 3}
    sfx: 
    broadcastAnEvent: 0
  gameLoseDialogue:
  - bodyText: Tsk, I better get away and recover. Maybe changing up my weapon techniques
      will help?
    speakerName: Jackie
    displayingImage: {fileID: 0}
    sfx: 
    broadcastAnEvent: 0
  references:
    version: 2
    RefIds:
    - rid: 5589630762363650048
      type: {class: ActorAction, ns: DialogueScripts, asm: Assembly-CSharp}
      data:
        actor: {fileID: 11400000, guid: 5e611c80cca3abf42b4a5c1a2294b953, type: 2}
        action: 20
        duration: 0
    - rid: 5589630762363650049
