  secondFightBaseCameraPosition: {fileID: 736300720}
  frog: {fileID: 536162465}
  frogInitialWalkIn: {fileID: 700548914}
  frogConfrontPosition: {fileID: 390097422}
  frogFightPosition: {fileID: 1436546157}
  jackieFightPosition: {fileID: 1878372940}
  frog2: {fileID: 2026599494}
