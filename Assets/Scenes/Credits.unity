      m_Calls: []
  m_text: "Hey Ma,\r\n\r\nI still can\u2019t believe it. I\u2019m finally one of
    the NITES. \r\n\n\nAll those years of training finally paid off. Mama\u2026 I
    can finally begin my search for you. \r\n\n\nI swear, no matter where you are
    in the Wasteland, I\u2019ll find you.\r\n\n\nAnd we will go home, together.\r\n\r\n\nLove
    you,\r\nJackie\r\n"
  m_isRightToLeft: 0
